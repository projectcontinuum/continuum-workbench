{
  "private": true,
  "name": "@continuum/workbench",
  "version": "0.0.11",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@theia/core": "latest",
    "@theia/filesystem": "latest",
    "@theia/markers": "latest",
    "@theia/messages": "latest",
    "@theia/monaco": "latest",
    "@theia/navigator": "latest",
    "@theia/preferences": "latest",
    "@theia/process": "latest",
    "@theia/property-view": "latest",
    "@theia/workspace": "latest",
    "@theia/ai-chat": "latest",
    "@theia/ai-chat-ui": "latest",
    "@theia/ai-code-completion": "latest",
    "@theia/ai-core": "latest",
    "@theia/ai-core-ui": "latest",
    "@theia/ai-history": "latest",
    "@theia/ai-ollama": "latest",
    "@theia/ai-ide": "latest",
    "@continuum/core": "*",
    "@continuum/workflow-editor-extension": "*"
  },
  "devDependencies": {
    "@theia/cli": "latest",
    "monaco-editor-webpack-plugin": "^7.1.0",
    "terser-webpack-plugin": "5.3.10"
  },
  "scripts": {
    "build": "theia build --mode=development",
    "build:prd": "theia build --mode=production",
    "build:dev": "theia build --mode=development",
    "rebuild": "theia rebuild:browser --cacheRoot ..",
    "start": "theia start --plugins=local-dir:./plugins --port 3002",
    "watch": "yarn rebuild && theia build --watch --mode development"
  },
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "Continuum",
        "defaultTheme": {
          "light": "continuum-light",
          "dark": "continuum-dark"
        },
        "defaultIconTheme": "theia-file-icons",
        "reloadOnReconnect": true
      }
    },
    "backend": {
      "config": {
        "configurationFolder": ".continuum"
      }
    },
    "generator": {
      "config": {
        "preloadTemplate": "resources/preload.html"
      }
    }
  }
}
